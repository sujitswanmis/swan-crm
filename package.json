{
  "name": "crm",
  "version": "2.5.1114",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:start": "electron desktop/main.js",
    "desktop:build": "electron-packager desktop \"SPC Workspace\" --platform=win32 --arch=x64 --out=dist-crm-desktop --asar --overwrite",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "powershell -Command \"$env:JAVA_HOME = 'C:\\Program Files\\Android\\Android Studio\\jbr'; Push-Location android; .\\gradlew.bat assembleDebug; $c = $LASTEXITCODE; Pop-Location; if ($c -ne 0) { exit $c }; New-Item -ItemType Directory -Force -Path 'SPC-APPS\\archive' | Out-Null; $dest = 'SPC-APPS\\SPC Workspace (Android).apk'; if (Test-Path $dest) { $ts = [System.TimeZoneInfo]::ConvertTimeBySystemTimeZoneId([DateTime]::UtcNow, 'India Standard Time').ToString('yyyyMMdd_HHmmss'); Move-Item -Path $dest -Destination ('SPC-APPS\\archive\\SPC Workspace (Android)_' + $ts + '.apk') }; Copy-Item -Path 'android\\app\\build\\outputs\\apk\\debug\\app-debug.apk' -Destination $dest\"",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-table": "^8.21.3",
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.8",
    "nodemailer": "^9.0.5",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "plivo": "4.79.0",
    "plivo-browser-sdk": "^2.2.21",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-draggable": "^4.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "rimraf": "^3.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@electron/packager": "^20.3.0",
    "@tailwindcss/postcss": "4.3.5",
    "electron": "45.2.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.5"
  },
  "build": {
    "appId": "com.supujacreations.workspace",
    "productName": "SuPuja Workspace",
    "copyright": "Copyright © 2026 SuPuja Creations",
    "npmRebuild": false,
    "directories": {
      "output": "dist-desktop-v1"
    },
    "files": [
      "desktop/**/*",
      "public/icon-512x512.png",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SuPuja Workspace"
    }
  }
}
